 void Graph::init_inclist_adjlist()
 {
-  igraph_lazy_inclist_init(this->_graph, &this->_inclist_in, IGRAPH_IN, IGRAPH_LOOPS_TWICE);
-  igraph_lazy_inclist_init(this->_graph, &this->_inclist_out, IGRAPH_OUT, IGRAPH_LOOPS_TWICE);
-  igraph_lazy_inclist_init(this->_graph, &this->_inclist_all, IGRAPH_ALL, IGRAPH_LOOPS_TWICE);
+  this->_is_directed = igraph_is_directed(this->_graph);
+  for (size_t m = 0; m < 3; m++)
+  {
+    this->_csr_built[m] = false;
+    this->_csr_offsets[m].clear();
+    this->_csr_neighs[m].clear();
+    this->_csr_edges[m].clear();
+  }
+}
+
+void Graph::build_csr(size_t m)
+{
+  static const igraph_neimode_t modes[3] = {IGRAPH_OUT, IGRAPH_IN, IGRAPH_ALL};
+  igraph_neimode_t mode = modes[m];
+  size_t n = this->vcount();
+  size_t ecount = this->ecount();
 
-  igraph_lazy_adjlist_init(this->_graph, &this->_adjlist_in, IGRAPH_IN, IGRAPH_LOOPS_TWICE, IGRAPH_MULTIPLE);
-  igraph_lazy_adjlist_init(this->_graph, &this->_adjlist_out, IGRAPH_OUT, IGRAPH_LOOPS_TWICE, IGRAPH_MULTIPLE);
-  igraph_lazy_adjlist_init(this->_graph, &this->_adjlist_all, IGRAPH_ALL, IGRAPH_LOOPS_TWICE, IGRAPH_MULTIPLE);
+  vector<size_t>& offsets = this->_csr_offsets[m];
+  vector<size_t>& neighs = this->_csr_neighs[m];
+  vector<size_t>& edges = this->_csr_edges[m];
+
+  size_t total = (mode == IGRAPH_ALL) ? 2*ecount : ecount;
+  offsets.resize(n + 1);
+  neighs.resize(total);
+  edges.resize(total);
+
+  igraph_vector_int_t incident;
+  igraph_vector_int_init(&incident, 0);
+  size_t pos = 0;
+  for (size_t v = 0; v < n; v++)
+  {
+    offsets[v] = pos;
+    igraph_incident(this->_graph, &incident, v, mode, IGRAPH_LOOPS_TWICE);
+    size_t degree = igraph_vector_int_size(&incident);
+    for (size_t idx = 0; idx < degree; idx++)
+    {
+      size_t e = VECTOR(incident)[idx];
+      edges[pos] = e;
+      neighs[pos] = IGRAPH_OTHER(this->_graph, e, v);
+      pos++;
+    }
+  }
+  offsets[n] = pos;
+  igraph_vector_int_destroy(&incident);
+  neighs.resize(pos);
+  edges.resize(pos);
+  this->_csr_built[m] = true;
 }
 
