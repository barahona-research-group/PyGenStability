+      if (!this->_csr_built[m])
+        this->build_csr(m);
+      const size_t* base = this->_csr_neighs[m].data();
+      return IndexRange(base + this->_csr_offsets[m][v], base + this->_csr_offsets[m][v + 1]);
+    }
